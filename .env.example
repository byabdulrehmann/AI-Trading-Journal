# Copy to .env.local and fill in. Never commit real keys.

# Jarvis: Anthropic (Claude). Leave empty to use demo mode only.
ANTHROPIC_API_KEY=
# Optional: default Claude model when you pick Anthropic without naming a model.
KESTREL_ANTHROPIC_MODEL=claude-opus-5-5

# Optional: where the SQLite database lives (default: ./data/kestrel.db).
KESTREL_DB_PATH=

# Only for serving Jarvis to other machines (it answers on this computer alone by default). Also change -H 127.0.0.1
# in the npm scripts, and put Jarvis behind an HTTPS reverse proxy.
# Extra host names it answers to, comma separated, e.g. jarvis.example.com,10.0.0.5:3100
JARVIS_ALLOWED_HOSTS=
# 1 behind HTTPS: session cookies become Secure and browsers are told to use HTTPS only (HSTS).
JARVIS_HTTPS=
# 1 behind a reverse proxy you run: rate limits count per visitor address, from the last X-Forwarded-For entry.
JARVIS_TRUST_PROXY=
