# Copy to .env.local and fill in. Never commit real keys.

# Jarvis: Anthropic (Claude). Leave empty to use demo mode only.
ANTHROPIC_API_KEY=
# Optional: default Claude model when you pick Anthropic without naming a model.
KESTREL_ANTHROPIC_MODEL=claude-opus-5-5

# Optional: where the SQLite database lives (default: ./data/kestrel.db).
KESTREL_DB_PATH=

# TradBot-I (your own Jarvis desktop app) — its remote dashboard address.
# Kestrel's server connects here; the browser never does. Default shown.
TRADBOT_URL=http://127.0.0.1:8000
